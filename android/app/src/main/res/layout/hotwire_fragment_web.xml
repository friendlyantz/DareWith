<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides Hotwire Native's layout: no toolbar, the page fills the screen and scrolls under the status bar.
     Forms that slide up get a close button floating at the top right, beside their heading.
     WebFragment shows it and keeps it below the status bar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <include
        layout="@layout/hotwire_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/status_bar_fade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/status_bar_fade" />

    <FrameLayout
        android:id="@+id/floating_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:background="@drawable/floating_button"
            android:contentDescription="Close"
            android:elevation="2dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
