<?xml version="1.0" encoding="utf-8"?>
<!-- A solid circle, so the close button stays readable over the page scrolling under them -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/base_300">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/base_100" />
            <stroke android:width="1dp" android:color="@color/base_300" />
        </shape>
    </item>
</ripple>
