<%# locals: (url:) %>
<div role="alert" class="flex flex-col gap-3 rounded-box border border-warning/40 bg-warning/15 p-4">
  <div>
    <p class="font-semibold">Open this in your browser</p>
    <p class="text-sm text-base-content/80">
      Passkeys don't work inside this app's built-in browser. Open the link in Safari or Chrome to sign up, or sign in with email instead.
    </p>
  </div>
  <ul class="list-disc pl-5 text-sm text-base-content/80">
    <li>iPhone: tap ⋯ or the share button, then "Open in Safari"</li>
    <li>Android: tap ⋮, then "Open in Chrome" or "Open in browser"</li>
  </ul>
  <div class="flex flex-col gap-2">
    <button type="button" class="btn btn-primary" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy">Copy link</button>
    <%= link_to "Sign in with email instead", new_email_session_path, class: "btn btn-ghost btn-sm" %>
  </div>
</div>
