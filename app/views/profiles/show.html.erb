<% content_for :title, "Me" %>
<div class="w-full max-w-md flex flex-col gap-6 pt-2" data-controller="push-notifications" data-push-notifications-endpoints-value="<%= @push_devices.map(&:endpoint).to_json %>">
  <h1 class="font-display text-4xl font-bold tracking-tight">Me</h1>

  <div class="flex items-center gap-4">
    <%= form_with model: current_user, url: avatar_path, method: :patch,
      data: {controller: "image-compressor autosubmit", action: "image-compressor:compressed->autosubmit#submit"} do |form| %>
      <label class="relative block cursor-pointer" title="Change photo">
        <%= render "shared/avatar", name: current_user.username, user: current_user, size: "size-16", text: "font-display text-xl" %>
        <span class="absolute -right-1 -bottom-1 flex size-7 items-center justify-center rounded-full border-2 border-base-200 bg-base-100">
          <%= icon(:camera, css: "size-4") %>
        </span>
        <span class="sr-only">Change photo</span>
        <%= form.file_field :avatar,
          accept: "image/*",
          class: "sr-only",
          data: {image_compressor_target: "input", action: "change->image-compressor#compress"} %>
      </label>
    <% end %>
    <div>
      <p class="text-lg font-semibold"><%= current_user.username %></p>
      <p class="text-sm text-base-content/70">
        <%= pluralize(@active_challenges_count, "active challenge") %> · <%= @past_challenge_stories.size + @wrap_up_stories.size %> finished
      </p>
      <% if current_user.avatar.attached? %>
        <%= button_to "Remove photo", avatar_path, method: :delete, class: "link link-hover text-sm text-base-content/70", form_class: "mt-0.5" %>
      <% else %>
        <p class="text-sm text-base-content/60 mt-0.5">Tap to add a photo. Friends and anyone with a challenge link can see it.</p>
      <% end %>
    </div>
  </div>

  <%= render "credentials/backup_nudge" if current_user.needs_backup_passkey? %>

  <%= render "profiles/badges", badges_by_kind: @badges_by_kind, next_badges: @next_badges %>

  <ul class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
    <li class="flex min-h-14 items-center gap-3 px-4">
      <%= icon(:bell, css: "size-5 text-base-content/70") %>
      <label for="push_toggle" class="flex-1">Notifications in this browser</label>
      <input id="push_toggle" type="checkbox" class="toggle toggle-primary" data-push-notifications-target="toggle" data-action="change->push-notifications#toggle">
    </li>
    <li class="flex min-h-14 items-center gap-3 px-4">
      <%= icon(:clock, css: "size-5 text-base-content/70") %>
      <%= form_with model: current_user, url: profile_path, method: :patch, class: "flex flex-1 items-center gap-3", data: {controller: "autosubmit"} do |form| %>
        <%= form.label :reminder_hour, "Daily reminder", class: "flex-1" %>
        <%= form.select :reminder_hour,
          User::REMINDER_HOURS.map { [format("%02d:00", it), it] },
          {include_blank: "Off"},
          class: "select select-sm w-28",
          data: {action: "autosubmit#submit"} %>
      <% end %>
    </li>
    <li>
      <%= link_to credentials_path, class: "flex min-h-14 items-center gap-3 px-4" do %>
        <%= icon(:key, css: "size-5 text-base-content/70") %>
        <span class="flex-1">Passkeys</span>
        <span class="text-sm text-base-content/70"><%= current_user.credentials.size %></span>
        <%= icon(:chevron_right, css: "size-5 text-base-content/50") %>
      <% end %>
    </li>
    <li>
      <%= link_to new_device_sign_in_approval_path, class: "flex min-h-14 items-center gap-3 px-4" do %>
        <%= icon(:phone, css: "size-5 text-base-content/70") %>
        <span class="flex-1">Sign in another device</span>
        <%= icon(:chevron_right, css: "size-5 text-base-content/50") %>
      <% end %>
    </li>
    <li>
      <details class="group">
        <summary class="flex min-h-14 cursor-pointer list-none items-center gap-3 px-4">
          <%= icon(:archive, css: "size-5 text-base-content/70") %>
          <span class="flex-1">Past challenges</span>
          <span class="text-sm text-base-content/70"><%= @past_challenge_stories.size + @wrap_up_stories.size %></span>
          <%= icon(:chevron_right, css: "size-5 text-base-content/50 transition-transform group-open:rotate-90") %>
        </summary>
        <ul class="border-t border-base-300 pb-1">
          <% @wrap_up_stories.each do |challenge_story| %>
            <li>
              <%= link_to challenge_story_challenge_rewards_path(challenge_story), class: "flex items-center gap-3 py-2.5 pl-12 pr-4" do %>
                <div class="flex-1 min-w-0">
                  <p class="truncate font-semibold"><%= challenge_story.title %></p>
                  <p class="text-sm text-base-content/70">Ended <%= challenge_story.finish.strftime("%-d %b %Y") %></p>
                </div>
                <span class="badge badge-sm badge-warning shrink-0">Wrap up</span>
              <% end %>
            </li>
          <% end %>
          <% @past_challenge_stories.each do |challenge_story| %>
            <li>
              <%= link_to challenge_story, class: "flex items-center gap-3 py-2.5 pl-12 pr-4" do %>
                <div class="flex-1 min-w-0">
                  <p class="truncate font-semibold"><%= challenge_story.title %></p>
                  <p class="text-sm text-base-content/70">Ended <%= challenge_story.finish.strftime("%-d %b %Y") %></p>
                </div>
              <% end %>
            </li>
          <% end %>
          <% if @past_challenge_stories.empty? && @wrap_up_stories.empty? %>
            <li class="py-2.5 pl-12 pr-4 text-sm text-base-content/70">None yet</li>
          <% end %>
        </ul>
      </details>
    </li>
  </ul>

  <p class="-mt-3 px-1 text-xs text-base-content/60">
    Get notified when friends check in, join, or pledge you a reward, plus a daily reminder if you haven't checked in yet
    (<%= current_user.time_zone.tr("_", " ") %> time). On iPhone, add Strivo to your Home Screen first.
  </p>

  <section class="flex flex-col gap-2">
    <h2 class="text-sm font-semibold text-base-content/70">How friends pay you</h2>
    <%= form_with model: current_user, url: profile_path, method: :patch, class: "flex flex-col gap-2 rounded-box border border-base-300 bg-base-100 p-4" do |form| %>
      <%= form.label :payment_details, "Payment link or details", class: "sr-only" %>
      <div class="flex gap-2">
        <%= form.text_field :payment_details,
          maxlength: 120,
          placeholder: "paypal.me/you or a PayID",
          class: "input flex-1 min-w-0" %>
        <%= form.submit "Save", class: "btn btn-primary" %>
      </div>
      <p class="text-xs text-base-content/60">Shown to friends who owe you a reward once a challenge ends. Strivo never handles the money.</p>
    <% end %>
  </section>

  <% if @push_devices.any? %>
    <section class="flex flex-col gap-2">
      <h2 class="text-sm font-semibold text-base-content/70">Notifications go to</h2>
      <ul class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
        <% @push_devices.each do |device| %>
          <li class="flex min-h-14 items-center gap-3 px-4 py-2" data-push-notifications-target="device" data-endpoint="<%= device.endpoint %>">
            <div class="flex-1 min-w-0">
              <p class="truncate"><%= device.label %></p>
              <p class="text-sm text-base-content/70">Added <%= device.created_at.strftime("%-d %b %Y") %></p>
            </div>
            <span class="badge badge-sm badge-info badge-soft hidden" data-role="this-device">This browser</span>
            <%= button_to "Remove", web_push_notification_path(device),
              method: :delete,
              class: "btn btn-ghost btn-sm text-error" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= button_to "Sign out", webauthn_session_path, method: :delete, class: "btn btn-block h-12 border-base-300 bg-base-100 text-error" %>
</div>
