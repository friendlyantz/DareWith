<%# locals: (challenge_story:) %>
<% participant = challenge_story.participant_for(current_user) %>
<article id="<%= dom_id(challenge_story, :today) %>" class="card bg-base-100 border border-base-300">
  <%= link_to challenge_story, class: "flex items-start gap-3 px-4 pt-4 pb-3" do %>
    <div class="flex-1 min-w-0">
      <h2 class="font-display text-lg font-semibold leading-tight"><%= challenge_story.title %></h2>
      <p class="text-sm text-base-content/70 mt-0.5">
        <% if challenge_story.weekly? %>
          <%= week_progress(participant) %>
        <% else %>
          <%= challenge_story.goal.progress_label %> · ends <%= challenge_story.finish.strftime("%-d %b") %>
        <% end %>
        <%= render "shared/streak", challenge_story:, count: participant.streak.current, css: "ml-1" %>
      </p>
      <div class="flex items-center gap-2 mt-2.5">
        <progress class="progress progress-secondary h-1" value="<%= challenge_story.current_day %>" max="<%= challenge_story.duration_in_days %>"
          aria-label="Challenge progress"></progress>
        <span class="text-xs text-base-content/60 whitespace-nowrap">Day <%= challenge_story.current_day %> of <%= challenge_story.duration_in_days %></span>
      </div>
    </div>
    <%= icon(:chevron_right, css: "size-5 mt-0.5 shrink-0 text-base-content/50") %>
  <% end %>

  <%= render "challenge_nudges/nudged_by", participant:, css: "mx-4 mb-2" %>

  <div class="flex items-center justify-between gap-3 px-4 pb-4">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="flex -space-x-1 shrink-0">
        <% challenge_story.active_participants.each do |participant| %>
          <%= render "shared/avatar", name: participant.name, user: participant.user, checked_in: participant.checked_in_today?, size: "size-7" %>
        <% end %>
      </div>
      <span class="text-sm text-base-content/70 truncate">
        <%= challenge_story.checked_in_today_count %> of <%= challenge_story.active_participants.size %> checked in today
      </span>
    </div>

    <% if participant.done_for_now? %>
      <span class="badge badge-info badge-soft badge-lg font-semibold shrink-0">
        <%= icon(:check, css: "size-4") %> <%= participant.checked_in_today? ? "Done" : "Week done" %>
      </span>
    <% else %>
      <%= link_to new_challenge_story_challenge_check_in_path(challenge_story),
        class: "btn btn-primary rounded-full shrink-0",
        data: {turbo_frame: "new_message", action: "sheet#open"} do %>
        <%= icon(:camera) %> Check in
      <% end %>
    <% end %>
  </div>
</article>
