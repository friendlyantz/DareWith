<%# locals: (challenge_story:) %>
<% pending_count = challenge_story.participant_for(current_user).pending_rewards_count %>
<%= link_to challenge_story_challenge_finale_path(challenge_story), id: dom_id(challenge_story, :just_finished), class: "flex items-center gap-3 rounded-box border border-base-300 bg-base-100 p-4" do %>
  <div class="flex size-10 shrink-0 items-center justify-center rounded-field bg-primary/10 text-accent">
    <%= icon(:gift) %>
  </div>
  <div class="flex-1 min-w-0">
    <p class="font-semibold truncate"><%= challenge_story.title %></p>
    <p class="text-sm text-base-content/70">
      That's a wrap · see the finale<%= " · #{pluralize(pending_count, "pledge")} to settle" if pending_count.positive? %>
    </p>
    <% unless challenge_story.completed? %>
      <p class="text-xs text-base-content/60 mt-0.5">Completes by itself on <%= challenge_story.completes_at.in_time_zone.strftime("%-d %b") %></p>
    <% end %>
  </div>
  <%= icon(:chevron_right, css: "size-5 shrink-0 text-base-content/50") %>
<% end %>
