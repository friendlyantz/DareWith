<%# locals: (challenge_story:, count:, css: "") %>
<% if count > 1 %>
  <span class="inline-flex shrink-0 items-center gap-0.5 align-text-bottom text-sm font-semibold text-accent <%= css %>" title="<%= streak_phrase(count, challenge_story) %>">
    <%= icon(:flame, css: "size-4") %><%= count %>
    <span class="sr-only"><%= challenge_story.goal.period_name.pluralize %> in a row</span>
  </span>
<% end %>
