<% content_for :title, "Create an account" %>
<div class="w-full max-w-sm flex flex-col gap-5 pt-6">
  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Create an account</h1>
    <p class="text-sm text-base-content/70 mt-1">No password: you sign in with a passkey saved on this device.</p>
  </div>

  <% if likely_webview? %>
    <%= render "application/alerts/unsupported_browser", url: browser_handoff_url %>
  <% else %>
    <%= render "webauthn/alerts/feature_detection", signing_up: true %>
  <% end %>

  <div class="rounded-box border border-base-300 bg-base-100 p-5">
    <%= form_with scope: :registration, url: webauthn_registration_path, id: "new-registration",
      data: {controller: "new-registration", turbo: false, action: "submit->new-registration#submit"} do |form| %>
      <%= form.label :username, "Username", class: "text-sm font-semibold" %>
      <div class="mdc-text-field mdc-text-field--fullwidth mt-1.5" data-controller="textfield" data-new-registration-target="usernameField">
        <%= form.text_field :username, class: "input mdc-text-field__input w-full", placeholder: "e.g. anton", required: true, autocapitalize: "none", "aria-controls" => "username-helper-text" %>
      </div>
      <div class="mdc-text-field-helper-line">
        <div class="mdc-text-field-helper-text mdc-text-field-helper-text--validation-msg text-sm text-error mt-1" id="username-helper-text"></div>
      </div>
      <p class="text-xs text-base-content/70 mt-1">Friends see this name. It can't be changed later.</p>

      <%= form.submit "Create account", class: "btn btn-primary mt-5 w-full" %>
    <% end %>

    <%= render partial: "application/js_error" %>
  </div>

  <div class="flex flex-col gap-2 text-center text-sm">
    <p>
      Already have an account?
      <%= link_to "Sign in", new_webauthn_session_path, class: "link link-accent font-semibold" %>
    </p>
    <p><%= link_to "Create an account with email instead", new_email_registration_path, class: "link link-hover text-base-content/70" %></p>
  </div>

</div>
