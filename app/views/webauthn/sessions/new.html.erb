<% content_for :title, "Sign in" %>
<div class="w-full max-w-sm flex flex-col gap-5 pt-6">
  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Sign in</h1>
    <p class="text-sm text-base-content/70 mt-1">Use the passkey saved on this device.</p>
  </div>

  <% if likely_webview? %>
    <%= render "application/alerts/unsupported_browser", url: browser_handoff_url %>
  <% end %>

  <%= render partial: "webauthn/alerts/feature_detection" %>

  <div class="rounded-box border border-base-300 bg-base-100 p-5">
    <%= form_with scope: :session, url: webauthn_session_path, id: "new-session",
      data: {controller: "new-session", turbo: false, action: "submit->new-session#submit"} do |form| %>
      <%= form.label :username, "Username", class: "text-sm font-semibold" %>
      <div class="mdc-text-field mdc-text-field--fullwidth mt-1.5" data-controller="textfield" data-new-session-target="usernameField">
        <%= form.text_field :username, class: "input mdc-text-field__input w-full", placeholder: "Username", required: true, autocapitalize: "none", "aria-controls" => "username-helper-text" %>
      </div>
      <div class="mdc-text-field-helper-line">
        <div class="mdc-text-field-helper-text mdc-text-field-helper-text--validation-msg text-sm text-error mt-1"></div>
      </div>
      <%= form.submit "Sign in with passkey", class: "btn btn-primary mt-4 w-full" %>
    <% end %>
    <p class="text-xs text-base-content/60 mt-3">Passkey on your phone? Choose "Use a phone or tablet" when your browser asks.</p>

    <%= render partial: "application/js_error" %>
  </div>

  <%= button_to device_sign_in_path, class: "btn h-auto min-h-14 w-full justify-start gap-3 border-base-300 bg-base-100 py-2 text-left font-normal" do %>
    <%= icon(:phone, css: "size-5 shrink-0 text-base-content/70") %>
    <span class="flex-1">
      <span class="block font-semibold">Sign in with another device</span>
      <span class="block text-sm text-base-content/70">Approve from a phone or computer where you're signed in</span>
    </span>
  <% end %>

  <div class="flex flex-col gap-2 text-center text-sm">
    <p>
      New here?
      <%= link_to "Create an account", new_webauthn_registration_path, class: "link link-accent font-semibold" %>
    </p>
    <p><%= link_to "Sign in with email instead", new_email_session_path, class: "link link-hover text-base-content/70" %></p>
  </div>

</div>
