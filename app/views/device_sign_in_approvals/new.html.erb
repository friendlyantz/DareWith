<% content_for :title, "Sign in another device" %>
<div class="w-full max-w-md flex flex-col gap-5">
  <%# The Android app's toolbar has its own back button %>
  <% unless hotwire_native_app? %>
    <div class="-mx-2">
      <%= link_to profile_path, class: "btn btn-ghost px-2 gap-1" do %>
        <%= icon(:chevron_left) %> Me
      <% end %>
    </div>
  <% end %>

  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Sign in another device</h1>
    <p class="text-sm text-base-content/70 mt-1">On the new device, tap <strong>Sign in with another device</strong> to get a code.</p>
  </div>

  <% if @device_sign_in %>
    <div class="rounded-box border border-base-300 bg-base-100 p-5 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <%= icon(:phone, css: "size-8 text-base-content/70") %>
        <div>
          <p class="font-semibold">Sign in <%= @device_sign_in.device_label %>?</p>
          <p class="text-sm text-base-content/70">It will be signed in as <strong><%= current_user.username %></strong>.</p>
        </div>
      </div>
      <div role="alert" class="alert alert-warning alert-soft text-sm">
        Only approve if that device is in front of you. Never approve a code someone sent you.
      </div>
      <div class="flex gap-2">
        <%= link_to "Cancel", profile_path, class: "btn flex-1" %>
        <%= button_to "Approve", device_sign_in_approval_path, params: {code: @device_sign_in.code}, class: "btn btn-primary w-full", form_class: "flex-1" %>
      </div>
    </div>
  <% else %>
    <%= form_with url: new_device_sign_in_approval_path, method: :get, class: "rounded-box border border-base-300 bg-base-100 p-4 flex flex-col gap-3" do |form| %>
      <%= form.label :code, "Code shown on the new device", class: "text-sm font-semibold" %>
      <%= form.text_field :code,
        value: @code,
        required: true,
        maxlength: 7,
        autocomplete: "off",
        autocapitalize: "characters",
        spellcheck: false,
        placeholder: "ABC 123",
        class: "input w-full font-mono text-lg tracking-widest uppercase #{"input-error" if @code.present?}" %>
      <% if @code.present? %>
        <p class="text-sm text-error">That code has expired or doesn't exist.</p>
      <% end %>
      <%= form.submit "Continue", name: nil, class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>
