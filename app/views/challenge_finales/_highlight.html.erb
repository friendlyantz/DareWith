<%# locals: (emoji:, label:, participant:, detail:) %>
<div class="flex items-center gap-3 rounded-box bg-neutral-content/10 p-3">
  <span class="text-3xl" aria-hidden="true"><%= emoji %></span>
  <div class="min-w-0 flex-1">
    <p class="text-xs font-semibold uppercase tracking-wider opacity-70"><%= label %></p>
    <p class="font-semibold"><%= participant.name %></p>
    <p class="text-sm opacity-80"><%= detail %></p>
  </div>
  <%= render "shared/avatar", name: participant.name, user: participant.user, size: "size-10", text: "text-xs" %>
</div>
