<% content_for :title, "Passkeys" %>
<div class="w-full max-w-md flex flex-col gap-5">
  <div class="-mx-2">
    <%= link_to profile_path, class: "btn btn-ghost px-2 gap-1" do %>
      <%= icon(:chevron_left) %> Me
    <% end %>
  </div>

  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Passkeys</h1>
    <p class="text-sm text-base-content/70 mt-1">Passkeys let you sign in as <strong><%= current_user.username %></strong> without a password. Add one for each device you use.</p>
  </div>

  <%= render "webauthn/alerts/feature_detection" %>

  <% if current_user.passkeys_left_on_old_domain? %>
    <div role="alert" class="alert alert-info alert-soft items-start">
      <%= icon(:key, css: "size-5 shrink-0") %>
      <div class="flex flex-col gap-1">
        <p class="font-semibold">We moved to <%= Rails.configuration.app_host %></p>
        <p class="text-sm">Passkeys only work on the site they were made for, so your old ones stay behind. Add a new passkey for this device below.</p>
      </div>
    </div>
  <% end %>

  <%= render "credentials/backup_nudge" if current_user.needs_backup_passkey? %>

  <ul class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
    <% current_user.credentials.each do |credential| %>
      <li class="flex min-h-14 items-center gap-3 px-4">
        <span class="flex-1 truncate"><%= credential.nickname %></span>
        <% if credential.backed_up %>
          <span class="badge badge-sm badge-success badge-soft shrink-0">Synced</span>
        <% elsif credential.backed_up == false %>
          <span class="badge badge-sm badge-ghost shrink-0">Not synced</span>
        <% end %>
        <% if current_user.can_delete_credentials? %>
          <%= button_to "Remove", credential,
            method: :delete,
            class: "btn btn-ghost btn-sm text-error",
            data: {turbo_confirm: "Remove the passkey \"#{credential.nickname}\"?"} %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div data-controller="add-credential" class="rounded-box border border-base-300 bg-base-100 p-4">
    <%= form_with scope: :credential, url: credentials_path, local: false, class: "flex flex-col gap-3", data: {action: "ajax:success->add-credential#create"} do |form| %>
      <div data-controller="textfield">
        <%= form.label :nickname, "Add a passkey for this device", class: "text-sm font-semibold" %>
        <%= form.text_field :nickname, class: "input w-full mt-1.5", placeholder: "e.g. iPhone", required: true %>
      </div>
      <%= form.submit "Add passkey", class: "btn btn-primary" %>
    <% end %>
  </div>

  <%= render "application/js_error" %>
</div>
