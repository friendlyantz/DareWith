<div class="rounded-box border border-base-300 bg-base-100 p-4 flex items-start gap-3">
  <%= icon(:key, css: "size-5 shrink-0 mt-0.5 text-primary") %>
  <div class="flex flex-col gap-1">
    <p class="font-semibold">Sign in faster next time</p>
    <p class="text-sm text-base-content/70">Add a passkey to sign in with Face ID or your fingerprint instead of waiting for an email.</p>
    <%= link_to "Add a passkey", credentials_path, class: "link link-primary font-semibold text-sm" %>
  </div>
</div>
