<div role="alert" class="alert alert-warning alert-soft items-start">
  <%= icon(:key, css: "size-5 shrink-0") %>
  <div class="flex flex-col gap-1">
    <p class="font-semibold">Your passkey only lives on one device</p>
    <p class="text-sm">If you lose it, you can't sign in. Add a passkey on another device, or save one to a password manager that syncs, like iCloud Keychain or 1Password.</p>
    <% unless current_page?(credentials_path) %>
      <%= link_to "Add a passkey", credentials_path, class: "link font-semibold text-sm" %>
    <% end %>
  </div>
</div>
