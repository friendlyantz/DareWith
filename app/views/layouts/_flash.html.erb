<% if notice.present? || alert.present? %>
  <div class="toast toast-top toast-center z-50" data-controller="dismiss" role="status">
    <% if notice.present? %>
      <div class="alert border-0 bg-base-content font-semibold text-base-100 shadow-lg"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-error font-semibold shadow-lg"><%= alert %></div>
    <% end %>
  </div>
<% end %>
