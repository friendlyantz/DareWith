<nav class="dock dock-md bg-base-100 border-t border-base-300" aria-label="Main">
  <% if current_user %>
    <%= link_to today_path, class: class_names("dock-active": current_page?(today_path)) do %>
      <%= icon(:sun, css: "size-6") %>
      <span class="dock-label">Today</span>
    <% end %>
    <%= link_to challenge_check_ins_path, class: class_names("dock-active": current_page?(challenge_check_ins_path)) do %>
      <%= icon(:photo, css: "size-6") %>
      <span class="dock-label">Feed</span>
    <% end %>
    <%= link_to profile_path, class: class_names("dock-active": current_page?(profile_path) || current_page?(credentials_path)) do %>
      <%= icon(:user, css: "size-6") %>
      <span class="dock-label">Me</span>
    <% end %>
  <% else %>
    <%= link_to root_path, class: class_names("dock-active": current_page?(root_path)) do %>
      <%= icon(:home, css: "size-6") %>
      <span class="dock-label">Home</span>
    <% end %>
    <%= link_to challenge_stories_path, class: class_names("dock-active": current_page?(challenge_stories_path)) do %>
      <%= icon(:compass, css: "size-6") %>
      <span class="dock-label">Challenges</span>
    <% end %>
    <%= link_to new_webauthn_session_path, class: class_names("dock-active": current_page?(new_webauthn_session_path)) do %>
      <%= icon(:log_in, css: "size-6") %>
      <span class="dock-label">Sign in</span>
    <% end %>
  <% end %>
</nav>
