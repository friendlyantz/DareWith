<%# The Android app shows the title in its toolbar, where the search-friendly one is too long %>
<% content_for :title, "DareWith · Dare your #{landing_dare_who}" %>
<div class="mx-auto flex w-full max-w-md flex-col gap-12 px-5 pt-10 pb-28">
  <section class="flex flex-col gap-5">
    <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight">Dare Your <%= landing_dare_who.capitalize %></h1>
    <p class="text-lg text-base-content/80">
      Daily challenges with friends and real stakes. Miss a day, and you owe them.
    </p>
    <div class="flex flex-col gap-3">
      <%= link_to "Get started", new_webauthn_registration_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Sign in", new_webauthn_session_path, class: "btn btn-lg border-base-300 bg-base-100" %>
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="font-display text-2xl font-bold tracking-tight">How it works</h2>
    <ol class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
      <% [
        [:plus, "Start a challenge", "Pick a template (push-ups, a run, kicking a vice) or write your own, for 1 to 4 weeks or 30 days."],
        [:share, "Invite up to #{ChallengeStory::MAX_PARTICIPANTS - 1} friends", "Send a short link. It shows a preview in WhatsApp and iMessage, and everyone checks in to the same challenge."],
        [:camera, "Check in with proof", "A photo and a line. Reps and minutes add up over the day. Friends can doubt a check-in, and you reply with proof."],
        [:target, "Put something on the line", "Each miss: coffee for everyone. Or pledge rewards for finishing, and settle up when time's up."]
      ].each do |icon_name, title, text| %>
        <li class="flex items-start gap-4 p-4">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-field bg-primary/10 text-accent">
            <%= icon(icon_name) %>
          </div>
          <div>
            <h3 class="font-semibold"><%= title %></h3>
            <p class="text-sm text-base-content/70"><%= text %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <%= render "challenge_stories/demo_challenges" %>

  <section class="flex flex-col items-start gap-3 rounded-box bg-neutral p-6 text-neutral-content">
    <h2 class="font-display text-2xl font-bold tracking-tight">Ready to start?</h2>
    <p class="opacity-80">It takes a minute: pick a username, sign in with a passkey, and set your first dare.</p>
    <%= link_to "Get started", new_webauthn_registration_path, class: "btn btn-primary" %>
  </section>
</div>
