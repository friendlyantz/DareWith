<% content_for :title, "Pick a username" %>
<div class="w-full max-w-sm flex flex-col gap-5 pt-6">
  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Pick a username</h1>
    <p class="text-sm text-base-content/70 mt-1">Last step. Your account is for <span class="font-semibold text-base-content"><%= @user.email %></span>.</p>
  </div>

  <% if @user.errors[:email].any? %>
    <div class="alert alert-error alert-soft">
      That email already has an account. <%= link_to "Sign in instead", new_email_session_path, class: "link font-semibold" %>
    </div>
  <% end %>

  <div class="rounded-box border border-base-300 bg-base-100 p-5">
    <%= form_with model: @user, url: email_registration_path, id: "email-registration-form", class: "flex flex-col gap-4" do |form| %>
      <div>
        <%= form.label :username, "Username", class: "text-sm font-semibold" %>
        <div data-controller="textfield" class="mt-1.5">
          <%= form.text_field :username,
            class: class_names("input mdc-text-field__input w-full", "input-error": @user.errors[:username].any?),
            placeholder: "e.g. sloth_no_more", required: true, autofocus: true, autocapitalize: "none" %>
        </div>
        <% @user.errors.full_messages_for(:username).each do |message| %>
          <p class="mt-1 text-sm text-error"><%= message %></p>
        <% end %>
        <p class="text-xs text-base-content/70 mt-1">Friends see this name. It can't be changed later.</p>
      </div>

      <%= form.submit "Create account", class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</div>
