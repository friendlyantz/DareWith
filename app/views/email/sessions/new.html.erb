<% content_for :title, "Sign in with email" %>
<div class="w-full max-w-sm flex flex-col gap-5 pt-6">
  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Sign in with email</h1>
    <p class="text-sm text-base-content/70 mt-1">We'll email you a sign-in link. New here? Add a username and we'll create your account.</p>
  </div>

  <% if @email_sent %>
    <div class="alert alert-success alert-soft">
      <% if @is_new_user %>
        Account created! Check your email to verify your account. Link expires in 24 hours.
      <% else %>
        Check your email for a sign-in link. It expires in 24 hours.
      <% end %>
    </div>
  <% elsif @error %>
    <div class="alert alert-error alert-soft"><%= @error %></div>
  <% end %>

  <% unless @email_sent %>
    <div class="rounded-box border border-base-300 bg-base-100 p-5">
      <%= form_with scope: :session, url: email_session_path, data: {turbo: false}, id: "email-form", class: "flex flex-col gap-4" do |form| %>
        <div>
          <%= form.label :email, "Email", class: "text-sm font-semibold" %>
          <div data-controller="textfield" class="mt-1.5">
            <%= form.email_field :email, class: "input mdc-text-field__input w-full", placeholder: "your@email.com", required: true, autocapitalize: "none" %>
          </div>
        </div>

        <div>
          <%= form.label :username, "Username", class: "text-sm font-semibold" %>
          <div data-controller="textfield" class="mt-1.5">
            <%= form.text_field :username, class: "input mdc-text-field__input w-full", placeholder: "Only for new accounts", autocapitalize: "none" %>
          </div>
          <p class="text-xs text-base-content/70 mt-1">Only needed for a new account. It can't be changed later.</p>
        </div>

        <%= form.submit "Continue with email", class: "btn btn-primary w-full" %>
      <% end %>
    </div>
  <% end %>

  <p class="text-center text-sm">
    <%= link_to "Sign in with a passkey instead", new_webauthn_session_path, class: "link link-hover text-base-content/70" %>
  </p>
</div>
