<% content_for :title, "Continue with email" %>
<div class="w-full max-w-sm flex flex-col gap-5 pt-6">
  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Continue with email</h1>
    <p class="text-sm text-base-content/70 mt-1">New or back again, we'll email you a code. No password needed.</p>
  </div>

  <% if @error %>
    <div class="alert alert-error alert-soft"><%= @error %></div>
  <% end %>

  <div class="rounded-box border border-base-300 bg-base-100 p-5">
    <%= form_with scope: :session, url: email_session_path, id: "email-form", class: "flex flex-col gap-4" do |form| %>
      <div>
        <%= form.label :email, "Email", class: "text-sm font-semibold" %>
        <div data-controller="textfield" class="mt-1.5">
          <%= form.email_field :email, value: params.dig(:session, :email), class: "input mdc-text-field__input w-full", placeholder: "your@email.com", required: true, autocapitalize: "none" %>
        </div>
      </div>

      <%= form.submit "Continue with email", class: "btn btn-primary w-full" %>
    <% end %>
  </div>

  <div class="flex flex-col gap-2 text-center text-sm">
    <p><%= link_to "Sign in with a passkey instead", new_webauthn_session_path, class: "link link-hover text-base-content/70" %></p>
  </div>
</div>
