<%# locals: (dismissable:) %>
<%# The install-app controller shows this only when the browser has an install offer ready %>
<div data-controller="install-app" data-action="install-app:changed@window->install-app#refresh" hidden class="w-full">
  <div class="flex items-start gap-3 rounded-box border border-base-300 bg-base-200 p-3 text-left text-sm">
    <%= icon(:phone, css: "mt-0.5 size-5 shrink-0 text-primary") %>
    <div class="flex flex-1 flex-wrap items-center gap-2">
      <span class="flex-1 min-w-40">Add DareWith to your Home Screen to check in with one tap</span>
      <div class="flex gap-1">
        <button data-action="install-app#install" class="btn btn-sm btn-primary">Add</button>
        <% if dismissable %>
          <button data-action="install-app#dismiss" class="btn btn-sm btn-ghost">Later</button>
        <% end %>
      </div>
    </div>
  </div>
</div>
