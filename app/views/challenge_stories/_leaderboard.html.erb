<%# locals: (challenge_story:) %>
<% if challenge_story.active_participants.any? %>
  <% goal = challenge_story.goal %>
  <% so_far = goal.current_period_number %>
  <% mine = current_user && challenge_story.participant_for(current_user) %>
  <% solo = mine && challenge_story.active_participants.size == 1 %>
  <p class="text-sm text-base-content/70 mb-2">
    <% if solo %>
      Just one person so far. Invite friends to make it a race.
    <% elsif challenge_story.total? %>
      Totals so far, aiming for <%= goal.format_amount(challenge_story.target_amount) %> each
    <% else %>
      <%= challenge_story.weekly? ? "Weeks with #{challenge_story.times_per_period} check-ins" : "Days checked in" %>, out of <%= so_far %> so far
    <% end %>
  </p>
  <ol class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
    <% challenge_story.ranked_participants.each.with_index(1) do |participant, rank| %>
      <li class="flex items-center gap-3 px-4 py-3">
        <% unless solo %><span class="w-4 font-display font-bold text-base-content/60"><%= rank %></span><% end %>
        <%= render "shared/avatar", name: participant.name, user: participant.user, checked_in: participant.checked_in_today?, size: "size-9" %>
        <div class="flex-1 min-w-0 flex flex-col gap-1.5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="font-semibold truncate"><%= participant.name %></span>
            <span class="shrink-0 whitespace-nowrap text-sm text-base-content/70">
              <% if challenge_story.total? %>
                <%= goal.format_number(participant.total_amount) %>/<%= goal.format_number(challenge_story.target_amount) %>
                <span class="text-xs text-base-content/60"><%= goal.unit_label(challenge_story.target_amount) %></span>
              <% else %>
                <%= participant.periods_kept %>/<%= so_far %>
                <span class="text-xs text-base-content/60"><%= goal.period_name.pluralize(so_far) %></span>
              <% end %>
            </span>
          </div>
          <% if challenge_story.total? %>
            <progress class="progress progress-secondary h-1.5" value="<%= [participant.total_amount, challenge_story.target_amount].min %>" max="<%= challenge_story.target_amount %>"></progress>
          <% else %>
            <progress class="progress progress-secondary h-1.5" value="<%= participant.periods_kept %>" max="<%= so_far %>"></progress>
          <% end %>
          <% details = [] %>
          <% details << "#{participant.check_ins_this_period} of #{challenge_story.times_per_period} this week" if challenge_story.weekly? %>
          <% details << "#{goal.format_amount(participant.total_amount)} in total" if goal.measured? && !challenge_story.total? %>
          <% forecast = forecast_line(participant) if participant == mine %>
          <% if participant.streak.current > 1 || details.any? || forecast %>
            <p class="flex flex-wrap items-center gap-x-1.5 text-xs text-base-content/70">
              <%= render "shared/streak", challenge_story:, count: participant.streak.current, css: "text-xs" %>
              <%= details.join(" · ") %>
              <% if forecast %><span class="font-semibold text-secondary"><%= forecast %></span><% end %>
            </p>
          <% end %>
        </div>
        <% if mine && participant != mine %>
          <%= render "challenge_nudges/button", receiver: participant, sender: mine %>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="py-8 text-center text-base-content/70">No participants yet.</p>
<% end %>
