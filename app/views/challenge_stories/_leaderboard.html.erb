<%# locals: (challenge_story:) %>
<% if challenge_story.active_participants.any? %>
  <p class="text-sm text-base-content/70 mb-2">Days checked in, out of <%= challenge_story.current_day %> so far</p>
  <ol class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300">
    <% challenge_story.ranked_participants.each.with_index(1) do |participant, rank| %>
      <li class="flex items-center gap-3 px-4 py-3">
        <span class="w-4 font-display font-bold text-base-content/60"><%= rank %></span>
        <%= render "shared/avatar", name: participant.name, user: participant.user, size: "size-9" %>
        <div class="flex-1 min-w-0 flex flex-col gap-1.5">
          <div class="flex justify-between gap-2">
            <span class="flex min-w-0 items-center gap-1.5">
              <span class="font-semibold truncate"><%= participant.name %></span>
              <%= render "shared/streak", days: participant.streak.current %>
            </span>
            <span class="text-sm text-base-content/70 shrink-0"><%= participant.challenge_check_ins_count %> / <%= challenge_story.current_day %></span>
          </div>
          <progress class="progress progress-secondary h-1.5" value="<%= participant.challenge_check_ins_count %>" max="<%= challenge_story.current_day %>"></progress>
        </div>
        <% if participant.checked_in_today? %>
          <span class="w-16 text-right text-xs font-semibold text-info">Today ✓</span>
        <% else %>
          <span class="w-16 text-right text-xs font-semibold text-base-content/60">Not yet</span>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="py-8 text-center text-base-content/70">No participants yet.</p>
<% end %>
