<% content_for :title, @challenge_story.title %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @challenge_story %>

<div class="w-full max-w-md flex flex-col gap-4" data-controller="sheet">
  <%= render "challenge_stories/top_bar", challenge_story: @challenge_story, participant: @current_challenge_participant %>
  <%= render "challenge_stories/header", challenge_story: @challenge_story %>

  <% if @current_challenge_participant %>
    <% if @challenge_story.accepting_check_ins? %>
      <%= render "challenge_rewards/pledge_reminder_banner", current_challenge_participant: @current_challenge_participant %>
    <% end %>
  <% else %>
    <%= render "challenge_stories/join_card", challenge_story: @challenge_story %>
  <% end %>

  <div role="tablist" class="tabs tabs-box bg-base-300/60">
    <input type="radio" name="challenge_tabs" class="tab flex-1" aria-label="Check-ins" checked>
    <div class="tab-content pt-4">
      <div id="challenge_check_ins" class="flex flex-col gap-3">
        <%= render @challenge_story.challenge_check_ins %>
      </div>
      <% if @challenge_story.challenge_check_ins.empty? %>
        <p class="py-8 text-center text-base-content/70">
          <%= @challenge_story.accepting_check_ins? ? "No check-ins yet. Be the first today." : "No one checked in during this challenge." %>
        </p>
      <% end %>
    </div>

    <input type="radio" name="challenge_tabs" class="tab flex-1" aria-label="Leaderboard">
    <div class="tab-content pt-4">
      <%= render "challenge_stories/leaderboard", challenge_story: @challenge_story %>
    </div>

    <input type="radio" name="challenge_tabs" class="tab flex-1" aria-label="Rewards · <%= @challenge_story.challenge_rewards.size %>">
    <div class="tab-content pt-4">
      <%= render "challenge_stories/rewards", challenge_story: @challenge_story, participant: @current_challenge_participant %>
    </div>
  </div>

  <% if @current_challenge_participant %>
    <%= render "challenge_stories/check_in_bar", challenge_story: @challenge_story, participant: @current_challenge_participant %>
    <%= render "challenge_check_ins/sheet" %>
  <% end %>
</div>
