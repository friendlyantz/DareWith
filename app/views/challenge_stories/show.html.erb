<% content_for :title, @challenge_story.title %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @challenge_story %>

<%= tag.div class: "group/page w-full max-w-md flex flex-col gap-4", data: {controller: "sheet", can_reply: (true if @current_challenge_participant)} do %>
  <%= render "challenge_stories/top_bar", challenge_story: @challenge_story, participant: @current_challenge_participant %>
  <% can_invite = @current_challenge_participant && @challenge_story.accepting_check_ins? && !@challenge_story.at_capacity? %>
  <%= render "challenge_stories/header", challenge_story: @challenge_story, can_invite: %>

  <% if @current_challenge_participant %>
    <% if can_invite && @challenge_story.active_participants.size == 1 %>
      <%= render "challenge_stories/invite_card", challenge_story: @challenge_story %>
    <% end %>
    <% if @challenge_story.accepting_check_ins? %>
      <%= render "challenge_rewards/pledge_reminder_banner", current_challenge_participant: @current_challenge_participant %>
    <% end %>
    <% if @challenge_story.finished? %>
      <%= render "challenge_stories/next_round_card", challenge_story: @challenge_story %>
    <% end %>
  <% else %>
    <%= render "challenge_stories/join_card", challenge_story: @challenge_story %>
  <% end %>

  <div role="tablist" class="tabs tabs-box bg-base-300/60" data-controller="tabs" data-action="change->tabs#remember turbo:morph@window->tabs#restore">
    <input type="radio" name="challenge_tabs" id="challenge_tab_check_ins" class="tab flex-1" aria-label="Check-ins" checked>
    <div class="tab-content pt-4">
      <div id="challenge_check_ins" class="flex flex-col gap-3">
        <%= render @challenge_story.challenge_check_ins %>
      </div>
      <% if @challenge_story.challenge_check_ins.empty? %>
        <p class="py-8 text-center text-base-content/70">
          <%= @challenge_story.accepting_check_ins? ? "No check-ins yet. Be the first today." : "No one checked in during this challenge." %>
        </p>
      <% end %>
    </div>

    <input type="radio" name="challenge_tabs" id="challenge_tab_leaderboard" class="tab flex-1" aria-label="Leaderboard">
    <div class="tab-content pt-4">
      <%= render "challenge_stories/leaderboard", challenge_story: @challenge_story %>
    </div>

    <input type="radio" name="challenge_tabs" id="challenge_tab_rewards" class="tab flex-1" aria-label="Rewards · <%= @challenge_story.challenge_rewards.size %>">
    <div class="tab-content pt-4">
      <%= render "challenge_stories/rewards", challenge_story: @challenge_story, participant: @current_challenge_participant %>
    </div>
  </div>

  <% if @current_challenge_participant %>
    <%= render "challenge_stories/check_in_bar", challenge_story: @challenge_story, participant: @current_challenge_participant %>
    <%= render "shared/sheet", title: "Check in", frame_id: "new_message" %>
  <% end %>
<% end %>
