<% content_for :title, "New challenge" %>
<div class="w-full max-w-md flex flex-col gap-4">
  <div class="-mx-2">
    <%= link_to today_path, class: "btn btn-ghost px-2 gap-1" do %>
      <%= icon(:chevron_left) %> Today
    <% end %>
  </div>

  <div>
    <% if (previous = @challenge_story.previous_challenge_story) %>
      <h1 class="font-display text-3xl font-bold tracking-tight">Round <%= previous.round + 1 %></h1>
      <p class="text-sm text-base-content/70 mt-1">Same rules and length as last time. Change anything you like; everyone from round <%= previous.round %> gets an invite.</p>
    <% else %>
      <h1 class="font-display text-3xl font-bold tracking-tight">New challenge</h1>
      <p class="text-sm text-base-content/70 mt-1">Set the rules and dates, then share the link with up to <%= ChallengeStory::MAX_PARTICIPANTS - 1 %> friends.</p>
    <% end %>
  </div>

  <% unless @challenge_story.previous_challenge_story %>
    <%= render "templates", selected: @template %>
  <% end %>

  <%= render "form", challenge_story: @challenge_story,
    submit_text: @challenge_story.previous_challenge_story ? "Start round #{@challenge_story.previous_challenge_story.round + 1}" : "Start challenge" %>
</div>
