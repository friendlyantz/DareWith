<%# locals: (challenge_story:, can_invite: false) %>
<header class="flex flex-col gap-2">
  <% if challenge_story.completed? || challenge_story.finished? || challenge_story.round > 1 %>
    <div class="flex gap-2">
      <% if challenge_story.round > 1 %>
        <% if challenge_story.previous_challenge_story %>
          <%= link_to "Round #{challenge_story.round}", challenge_story.previous_challenge_story, class: "badge badge-accent badge-soft", title: "See round #{challenge_story.round - 1}" %>
        <% else %>
          <span class="badge badge-accent badge-soft">Round <%= challenge_story.round %></span>
        <% end %>
      <% end %>
      <% if challenge_story.completed? %>
        <span class="badge badge-ghost">Completed</span>
      <% elsif challenge_story.finished? %>
        <span class="badge badge-ghost">Time's up</span>
      <% end %>
    </div>
  <% end %>

  <h1 class="font-display text-3xl font-bold tracking-tight leading-tight"><%= challenge_story.title %></h1>
  <p class="text-sm text-base-content/70">
    <%= challenge_story.goal.progress_label %> · ends <%= challenge_story.finish.strftime("%-d %b") %>
  </p>
  <% if (goal_summary = challenge_story.goal.summary) %>
    <p class="flex items-center gap-1.5 text-sm font-semibold"><%= icon(:target, css: "size-4 text-secondary") %><%= goal_summary.upcase_first %></p>
  <% end %>
  <% if (penalty = penalty_summary(challenge_story)) %>
    <p class="flex items-center gap-1.5 text-sm font-semibold"><%= icon(:x, css: "size-4 text-error") %><%= penalty %></p>
  <% end %>
  <progress class="progress progress-secondary h-1.5" value="<%= challenge_story.current_day %>" max="<%= challenge_story.duration_in_days %>"></progress>

  <% if challenge_story.description.present? %>
    <div class="text-sm text-base-content/80 mt-1"><%= simple_format challenge_story.description %></div>
  <% end %>

  <% if challenge_story.active_participants.any? %>
    <div class="flex items-center gap-2.5 mt-1">
      <div class="flex -space-x-1 shrink-0">
        <% challenge_story.active_participants.each do |participant| %>
          <%= render "shared/avatar", name: participant.name, user: participant.user, checked_in: participant.checked_in_today? %>
        <% end %>
      </div>
      <% if can_invite %>
        <div data-controller="share-link" data-share-link-url-value="<%= challenge_story_url(challenge_story) %>">
          <button type="button" data-action="share-link#nativeShare" class="flex gap-1 -ml-1"
            aria-label="Invite friends, <%= pluralize(challenge_story.available_spots, "spot") %> left">
            <% challenge_story.available_spots.times do %>
              <span class="grid size-8 place-items-center rounded-full border-2 border-dashed border-base-content/30 text-base-content/60">
                <%= icon(:plus, css: "size-4") %>
              </span>
            <% end %>
          </button>
        </div>
      <% end %>
      <% if challenge_story.accepting_check_ins? %>
        <span class="text-sm text-base-content/70">
          <%= challenge_story.checked_in_today_count %> of <%= challenge_story.active_participants.size %> checked in today
        </span>
      <% end %>
    </div>
  <% end %>
</header>
