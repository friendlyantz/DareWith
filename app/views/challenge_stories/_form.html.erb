<%# locals: (challenge_story:, submit_text:) %>
<%= form_with(model: challenge_story, class: "flex flex-col gap-4 rounded-box border border-base-300 bg-base-100 p-5") do |form| %>
  <% if challenge_story.new_record? && challenge_story.previous_challenge_story_id %>
    <%= hidden_field_tag :previous_challenge_story_id, challenge_story.previous_challenge_story_id %>
  <% end %>

  <% if challenge_story.errors[:base].any? %>
    <div class="alert alert-error alert-soft"><%= challenge_story.errors[:base].to_sentence %></div>
  <% end %>

  <div>
    <%= form.label :title, "Title", class: "text-sm font-semibold" %>
    <%= form.text_field :title,
      class: class_names("input w-full mt-1.5", "input-error": challenge_story.errors[:title].any?),
      placeholder: "e.g. 30 days at the gym" %>
    <% challenge_story.errors.full_messages_for(:title).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :description, "Rules", class: "text-sm font-semibold" %>
    <%= form.text_area :description,
      rows: 5,
      class: class_names("textarea w-full mt-1.5 text-base", "textarea-error": challenge_story.errors[:description].any?),
      placeholder: "What counts as a check-in? What happens if someone misses a day?\n\ne.g. Any workout of 30+ minutes counts. Post a photo. Whoever misses the most days buys lunch." %>
    <% challenge_story.errors.full_messages_for(:description).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <fieldset class="group/goal flex flex-col gap-3" <%= "disabled" unless challenge_story.goal_editable? %>>
    <div>
      <%= form.label :unit, "What do you count?", class: "text-sm font-semibold" %>
      <%= form.select :unit,
        ChallengeStory.units.keys.map { [(it == "km") ? "Kilometres" : it.capitalize, it] },
        {include_blank: "Nothing, just check in"},
        class: "select w-full mt-1.5" %>
    </div>

    <div class="group-has-[option[value='']:checked]/goal:hidden">
      <%= form.label :target_amount, "Target (optional)", class: "text-sm font-semibold" %>
      <div class="grid grid-cols-2 gap-3 mt-1.5">
        <%= form.number_field :target_amount,
          value: challenge_story.target_amount && challenge_story.goal.format_number(challenge_story.target_amount),
          min: 0, step: "any", inputmode: "decimal",
          class: class_names("input w-full", "input-error": challenge_story.errors[:target_amount].any?),
          placeholder: "e.g. 50" %>
        <%= form.select :target_scope,
          [["each time", "each_time"], ["in total", "total"]],
          {},
          class: "select w-full" %>
      </div>
      <% challenge_story.errors.full_messages_for(:target_amount).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>

    <% unless challenge_story.goal_editable? %>
      <p class="text-sm text-base-content/70">The goal is fixed once someone has checked in.</p>
    <% end %>
  </fieldset>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :start, "Starts", class: "text-sm font-semibold" %>
      <%= form.date_field :start, class: class_names("input w-full mt-1.5", "input-error": challenge_story.errors[:start].any?) %>
    </div>
    <div>
      <%= form.label :finish, "Ends", class: "text-sm font-semibold" %>
      <%= form.date_field :finish, class: class_names("input w-full mt-1.5", "input-error": challenge_story.errors[:finish].any?) %>
    </div>
  </div>
  <% (challenge_story.errors.full_messages_for(:start) + challenge_story.errors.full_messages_for(:finish)).each do |message| %>
    <p class="-mt-2 text-sm text-error"><%= message %></p>
  <% end %>

  <%= form.button submit_text, type: "submit", class: "btn btn-primary btn-block mt-2" %>
<% end %>
