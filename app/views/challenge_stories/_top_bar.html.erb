<%# locals: (challenge_story:, participant:) %>
<div class="flex items-center justify-between -mx-2">
  <%= link_to current_user ? today_path : challenge_stories_path, class: "btn btn-ghost px-2 gap-1" do %>
    <%= icon(:chevron_left) %> <%= current_user ? "Today" : "Challenges" %>
  <% end %>

  <div class="flex items-center">
    <%= render "challenge_stories/likes", challenge_story: challenge_story %>

    <div data-controller="share-link" data-share-link-url-value="<%= challenge_story_url(challenge_story) %>">
      <button data-action="share-link#nativeShare" class="btn btn-ghost btn-circle" aria-label="Share invite link">
        <%= icon(:share) %>
      </button>
    </div>

    <% if participant || current_user&.admin? %>
      <details class="dropdown dropdown-end">
        <summary class="btn btn-ghost btn-circle" aria-label="More actions"><%= icon(:dots) %></summary>
        <ul class="dropdown-content menu z-20 w-52 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
          <% if participant %>
            <li><%= render "challenge_stories/share_card_button", participant: %></li>
            <li><%= link_to "Edit challenge", edit_challenge_story_path(challenge_story) %></li>
            <li><%= link_to "All rewards", challenge_story_challenge_rewards_path(challenge_story) %></li>
            <li>
              <%= button_to "Leave challenge", challenge_participant_path(participant),
                method: :delete,
                class: "text-error",
                data: {turbo_confirm: "Are you sure you want to leave this challenge?"} %>
            </li>
          <% end %>
          <% if current_user&.admin? %>
            <li>
              <%= button_to "Delete challenge", admin_challenge_story_path(challenge_story),
                method: :delete,
                class: "text-error",
                data: {turbo_confirm: "Delete \"#{challenge_story.title}\" for everyone? Its check-ins, replies, rewards and badges go too. This can't be undone."} %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
</div>
