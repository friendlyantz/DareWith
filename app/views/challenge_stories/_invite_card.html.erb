<%# locals: (challenge_story:, participant:) %>
<%# Replaced after a check-in (challenge_check_ins/success), so the progress card has it %>
<section id="<%= dom_id(challenge_story, :invite_card) %>" class="card bg-base-100 border border-base-300">
  <div class="card-body gap-3">
    <h2 class="font-display text-xl font-semibold">Invite your friends</h2>
    <p class="text-sm text-base-content/70">
      Challenges are easier with friends keeping you honest. Send them your progress card; up to <%= pluralize(challenge_story.available_spots, "friend") %> can join.
    </p>
    <div class="grid grid-cols-2 gap-2">
      <%= render "challenge_stories/share_card_button", participant:, css: "btn btn-primary btn-block rounded-full" do %>
        <%= icon(:share, css: "size-4") %> Share invite
      <% end %>
      <button type="button" class="btn btn-block rounded-full"
        data-controller="clipboard" data-clipboard-text-value="<%= challenge_story_share_url(challenge_story.share_code) %>" data-clipboard-copied-value="Link copied" data-action="clipboard#copy">
        Copy link
      </button>
    </div>
  </div>
</section>
