<% content_for :title, "Challenges" %>
<div class="w-full max-w-md flex flex-col gap-4">
  <div class="flex items-end justify-between gap-3">
    <h1 class="font-display text-4xl font-bold tracking-tight">Challenges</h1>
    <% if current_user %>
      <%= link_to new_challenge_story_path, class: "btn bg-base-100 rounded-full" do %>
        <%= icon(:plus, css: "size-4") %> New
      <% end %>
    <% end %>
  </div>

  <% if current_user %>
    <% if @challenge_stories.any? %>
      <div id="challenge_stories" class="flex flex-col gap-3">
        <% @challenge_stories.each do |challenge_story| %>
          <%= render "challenge_stories/challenge_story_card", challenge_story: challenge_story %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-box border border-base-300 bg-base-100 p-5 text-center">
        <p class="text-base-content/70">You're not in any challenges yet. Start one, or open a friend's invite link to join theirs.</p>
      </div>
    <% end %>
  <% else %>
    <div class="flex flex-col items-start gap-3 rounded-box border border-base-300 bg-base-100 p-5">
      <p class="text-base-content/80">Sign up to start your own challenge, or open a friend's invite link to join theirs.</p>
      <%= render "shared/call_to_action_sign_up" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= render "challenge_stories/demo_challenges" %>
  </div>
</div>
