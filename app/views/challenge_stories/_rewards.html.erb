<%# locals: (challenge_story:, participant:) %>
<div class="flex flex-col gap-3" data-controller="sheet">
  <% challenge_story.challenge_rewards.each do |reward| %>
    <%= render "challenge_rewards/reward_card", reward: reward, challenge_story: challenge_story %>
  <% end %>

  <% pledging_locked = participant && challenge_story.accepting_check_ins? && challenge_story.active_participants.size == 1 %>

  <% if challenge_story.challenge_rewards.empty? && !pledging_locked %>
    <p class="py-6 text-center text-base-content/70">No rewards yet. Pledge one to raise the stakes.</p>
  <% end %>

  <% if participant && challenge_story.accepting_check_ins? %>
    <% if pledging_locked %>
      <p class="py-6 text-center text-base-content/70">Invite someone to unlock reward pledging.</p>
    <% elsif participant.unpledged_participants.any? %>
      <%= link_to "Pledge a reward", new_challenge_story_challenge_reward_path(challenge_story),
        class: "btn bg-base-100",
        data: {turbo_frame: "new_reward", action: "sheet#open"} %>
      <%= render "shared/sheet", title: "Pledge a reward", frame_id: "new_reward" %>
    <% else %>
      <p class="text-sm text-center text-base-content/70">You've pledged a reward to everyone here.</p>
    <% end %>
  <% end %>

  <% if participant && challenge_story.finished? && !challenge_story.completed? %>
    <%= render "challenge_rewards/complete_button", challenge_story: challenge_story %>
  <% end %>
</div>
