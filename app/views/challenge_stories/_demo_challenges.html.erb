<% demo_challenges = ChallengeStory.includes(:active_participants).where(
  id: [
    "00000000-0000-4000-8000-000000000001",
    "00000000-0000-4000-8000-000000000002",
    "00000000-0000-4000-8000-000000000003"
  ]
) %>

<% if demo_challenges.any? %>
  <section class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <h2 class="font-display text-2xl font-bold tracking-tight">See it in action</h2>
      <span class="badge badge-ghost badge-sm">Demo</span>
    </div>
    <% demo_challenges.each do |challenge_story| %>
      <%= render "challenge_stories/challenge_story_card", challenge_story: challenge_story %>
    <% end %>
  </section>
<% end %>
