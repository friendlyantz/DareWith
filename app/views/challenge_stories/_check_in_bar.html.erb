<%# locals: (challenge_story:, participant:) %>
<div class="sticky bottom-[calc(4rem+env(safe-area-inset-bottom))] z-10 -mx-5 border-t border-base-300 bg-base-200 px-5 py-3">
  <% if !challenge_story.started? %>
    <div class="flex h-12 items-center justify-center gap-2 rounded-field bg-base-100 font-semibold">
      <%= starts_in(challenge_story) %> · <%= challenge_story.start.strftime("%a %-d %b") %>
    </div>
  <% elsif participant.checked_in_today? %>
    <div class="flex items-center gap-2">
      <div class="flex h-12 flex-1 items-center justify-center gap-2 rounded-field bg-info/10 font-semibold text-info">
        <%= icon(:check) %> You checked in today
      </div>
      <% if challenge_story.accepting_check_ins? %>
        <%= link_to new_challenge_story_challenge_check_in_path(challenge_story),
          class: "btn btn-soft btn-primary btn-lg",
          data: {turbo_frame: "new_message", action: "sheet#open"} do %>
          <%= icon(:plus) %> Again
        <% end %>
      <% end %>
    </div>
  <% elsif challenge_story.accepting_check_ins? %>
    <%= render "challenge_nudges/nudged_by", participant:, css: "mb-2" %>
    <%= link_to new_challenge_story_challenge_check_in_path(challenge_story),
      class: "btn btn-primary btn-lg btn-block",
      data: {turbo_frame: "new_message", action: "sheet#open"} do %>
      <%= icon(:camera) %> <%= check_in_button_label(participant) %>
    <% end %>
  <% elsif !challenge_story.completed? %>
    <p class="py-1 text-center text-sm">Check-ins are closed · completes by itself on <%= challenge_story.completes_at.in_time_zone.strftime("%-d %b") %></p>
  <% else %>
    <p class="py-1 text-center text-sm">This challenge is over. No more check-ins are allowed.</p>
  <% end %>
</div>
