<%# locals: (challenge_story:, participant:) %>
<div class="sticky bottom-16 z-10 -mx-5 border-t border-base-300 bg-base-200 px-5 py-3">
  <% if participant.checked_in_today? %>
    <div class="flex items-center gap-2">
      <div class="flex h-12 flex-1 items-center justify-center gap-2 rounded-field bg-info/10 font-semibold text-info">
        <%= icon(:check) %> You checked in today
      </div>
      <% if challenge_story.accepting_check_ins? %>
        <%= link_to new_challenge_story_challenge_check_in_path(challenge_story),
          class: "btn btn-soft btn-primary btn-lg",
          data: {turbo_frame: "new_message", action: "sheet#open"} do %>
          <%= icon(:plus) %> Again
        <% end %>
      <% end %>
    </div>
  <% elsif challenge_story.accepting_check_ins? %>
    <%= render "challenge_nudges/nudged_by", participant:, css: "mb-2 text-center" %>
    <%= link_to new_challenge_story_challenge_check_in_path(challenge_story),
      class: "btn btn-primary btn-lg btn-block",
      data: {turbo_frame: "new_message", action: "sheet#open"} do %>
      <%= icon(:camera) %> <%= check_in_button_label(participant) %>
    <% end %>
  <% elsif challenge_story.wrapping_up? %>
    <%= link_to challenge_story_challenge_rewards_path(challenge_story), class: "btn btn-primary btn-lg btn-block" do %>
      <%= icon(:gift) %> Time's up · wrap up
    <% end %>
  <% else %>
    <p class="py-1 text-center text-sm">This challenge is over. No more check-ins are allowed.</p>
  <% end %>
</div>
