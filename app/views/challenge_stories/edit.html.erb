<% content_for :title, "Edit challenge" %>
<div class="w-full max-w-md flex flex-col gap-4">
  <div class="-mx-2">
    <%= link_to challenge_story_path(@challenge_story), class: "btn btn-ghost px-2 gap-1" do %>
      <%= icon(:chevron_left) %> Back
    <% end %>
  </div>

  <h1 class="font-display text-3xl font-bold tracking-tight">Edit challenge</h1>

  <%= render "form", challenge_story: @challenge_story, submit_text: "Save changes" %>
</div>
