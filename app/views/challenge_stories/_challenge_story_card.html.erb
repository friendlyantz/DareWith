<%# locals: (challenge_story:) %>
<%= link_to challenge_story, class: "card overflow-hidden border border-base-300 bg-base-100" do %>
  <% if (photo_check_in = challenge_story.latest_photo_check_in) %>
    <%= cl_image_tag(photo_check_in.photo.key, width: 800, height: 400, crop: :fill, class: "w-full aspect-2/1 object-cover bg-base-200", alt: "") %>
  <% end %>
  <div class="flex flex-col gap-2 p-4">
    <div class="flex items-start justify-between gap-3">
      <h2 class="font-display text-lg font-semibold leading-tight"><%= challenge_story.title %></h2>
      <% if challenge_story.completed? %>
        <span class="badge badge-ghost badge-sm shrink-0">Completed</span>
      <% elsif challenge_story.finished? %>
        <span class="badge badge-ghost badge-sm shrink-0">Time's up</span>
      <% end %>
    </div>
    <p class="text-sm text-base-content/70">
      Day <%= challenge_story.current_day %> of <%= challenge_story.duration_in_days %> · <%= pluralize(challenge_story.challenge_check_ins_count, "check-in") %>
    </p>
    <% if challenge_story.active_participants.any? %>
      <div class="flex -space-x-1">
        <% challenge_story.active_participants.each do |participant| %>
          <%= render "shared/avatar", name: participant.name, user: participant.user, size: "size-7" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
