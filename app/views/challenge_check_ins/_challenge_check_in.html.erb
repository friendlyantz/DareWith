<% show_challenge = local_assigns.fetch(:show_challenge, false) %>
<% participant = challenge_check_in.challenge_participant %>
<%= tag.article id: dom_id(challenge_check_in), class: "card overflow-hidden border border-base-300 bg-base-100",
  data: {controller: "own-check-in", own_check_in_user_id_value: participant.user_id, own_check_in_day_value: challenge_check_in.checked_in_on.iso8601} do %>
  <div class="flex items-center gap-3 px-4 py-3">
    <%= render "shared/avatar", name: participant.name, user: participant.user, size: "size-9" %>
    <div class="flex-1 min-w-0">
      <div class="flex items-baseline justify-between gap-2">
        <span class="font-semibold truncate"><%= participant.user_id == current_user&.id ? "You" : participant.name %></span>
        <span class="flex shrink-0 items-center gap-1">
          <time class="text-xs text-base-content/60" datetime="<%= challenge_check_in.created_at.iso8601 %>"><%= short_time_ago(challenge_check_in.created_at) %></time>
          <%= button_to challenge_story_challenge_check_in_path(challenge_check_in.challenge_story_id, challenge_check_in),
            method: :delete,
            class: "btn btn-ghost btn-xs btn-circle text-base-content/60",
            "aria-label": "Delete check-in",
            form: {hidden: true, data: {own_check_in_target: "controls", turbo_confirm: "Delete this check-in? Its likes and replies go too."}} do %>
            <%= icon(:trash, css: "size-4") %>
          <% end %>
        </span>
      </div>
      <% if show_challenge %>
        <%= link_to challenge_check_in.challenge_story.title, challenge_story_path(challenge_check_in.challenge_story), class: "link link-hover link-accent block truncate text-sm font-semibold" %>
      <% end %>
    </div>
  </div>

  <% if challenge_check_in.photo.attached? %>
    <%= cl_image_tag(challenge_check_in.photo.key, width: 800, height: 600, crop: :fill, lazy: true, placeholder: true, class: "w-full aspect-4/3 object-cover bg-base-200", alt: "Check-in photo") %>
  <% end %>

  <% if challenge_check_in.amount %>
    <p class="px-4 pt-3 font-display text-2xl font-bold"><%= challenge_check_in.challenge_story.goal.format_amount(challenge_check_in.amount) %></p>
  <% end %>
  <div class="px-4 pt-3"><%= simple_format challenge_check_in.message %></div>
  <div class="flex flex-wrap items-center px-2 pb-1">
    <%= render "challenge_check_ins/likes", challenge_check_in: challenge_check_in %>
    <div class="hidden ml-auto has-open:w-full group-data-can-reply/page:block">
      <%= render "challenge_check_in_doubts/controls", challenge_check_in: %>
    </div>
  </div>
  <%= render "challenge_check_in_doubts/doubts", challenge_check_in: %>

  <div class="flex flex-col gap-2 px-4 pb-3">
    <div id="<%= dom_id(challenge_check_in, :replies) %>" class="flex flex-col gap-2 empty:hidden"><%= render challenge_check_in.challenge_check_in_replies %></div>
    <div class="hidden group-data-can-reply/page:block">
      <%= render "challenge_check_in_replies/form", challenge_check_in: %>
    </div>
  </div>
<% end %>
