<% liked = challenge_check_in.liked_by?(current_user) %>
<div id="challenge_check_in_<%= challenge_check_in.id %>_likes" class="inline-block">
  <%= button_to challenge_check_in_challenge_check_in_like_path(challenge_check_in),
    method: liked ? :delete : :post,
    class: class_names("btn btn-ghost btn-sm gap-1.5 px-2", liked ? "text-primary" : "text-base-content/70"),
    aria: {label: liked ? "Unlike" : "Like", pressed: liked} do %>
    <%= icon(:heart, css: class_names("size-5", "fill-current": liked)) %>
    <%= challenge_check_in.challenge_check_in_likes_count %>
  <% end %>
</div>
