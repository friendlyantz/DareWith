<% content_for :title, "Feed" %>
<div class="w-full max-w-md flex flex-col gap-4">
  <div>
    <p class="text-sm font-medium text-base-content/70">From your <%= pluralize(@challenge_stories.size, "active challenge") %></p>
    <h1 class="font-display text-4xl font-bold tracking-tight">Feed</h1>
  </div>

  <%= turbo_stream_from current_user, "challenge_check_ins_feed" %>
  <div id="challenge_check_ins_feed" class="flex flex-col gap-3">
    <%= render @challenge_check_ins, show_challenge: true %>
  </div>

  <% if @challenge_check_ins.empty? %>
    <div class="card border border-base-300 bg-base-100">
      <div class="card-body items-center text-center">
        <h2 class="font-display text-xl font-semibold">No check-ins yet</h2>
        <p class="text-base-content/70">Check-ins from you and your friends show up here as they happen.</p>
        <%= link_to "Go to Today", today_path, class: "btn btn-primary rounded-full mt-2" %>
      </div>
    </div>
  <% end %>
</div>
