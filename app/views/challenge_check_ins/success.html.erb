<% challenge_story = @challenge_participant.challenge_story %>
<% streak = @challenge_participant.streak.current %>
<%# Only stays open when there's something new to read %>
<% ask_for_push = !current_user.push_enabled? %>
<% auto_close = @new_badges.empty? && !@challenge_participant.streak.freeze_earned_today? && !@challenge_participant.missing_pledges? && !ask_for_push %>
<%= turbo_frame_tag "new_message" do %>
  <%= tag.div class: "flex flex-col items-center gap-5 pt-2 text-center",
    data: {controller: "close-sheet", action: ("click->close-sheet#close" if auto_close), close_sheet_after_value: (4000 if auto_close)}.compact do %>
    <div class="flex flex-col items-center gap-3">
      <div class="grid size-20 place-items-center rounded-full bg-accent/15 text-accent ring-2 ring-accent/40 motion-safe:animate-pop">
        <% if streak > 1 %>
          <%= icon(:flame, css: "size-10") %>
        <% else %>
          <%= icon(:check, css: "size-10") %>
        <% end %>
      </div>
      <div>
        <p class="font-display text-2xl font-bold">
          <%= streak > 1 ? streak_phrase(streak, challenge_story) : "Checked in" %>
        </p>
        <p class="text-sm text-base-content/70"><%= challenge_story.title %> · <%= challenge_story.goal.progress_label.downcase %></p>
        <% unless @challenge_participant.streak.freeze_earned_today? %>
          <% if (freeze_progress = freeze_progress_phrase(@challenge_participant.streak)) %>
            <p class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-info">
              <%= icon(:snowflake, css: "size-4 shrink-0") %><%= freeze_progress %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @challenge_participant.streak.freeze_earned_today? %>
      <p class="flex w-full items-center gap-3 rounded-box border border-info/30 bg-info/10 px-4 py-3 text-left text-sm motion-safe:animate-pop [animation-delay:300ms]">
        <%= icon(:snowflake, css: "size-6 shrink-0 text-info") %>
        <span><span class="font-semibold">Streak freeze earned.</span> Miss a day and it keeps your streak going.</span>
      </p>
    <% end %>

    <% if @new_badges.any? %>
      <ul class="flex w-full flex-col gap-2">
        <% delays = %w[[animation-delay:300ms] [animation-delay:450ms] [animation-delay:600ms] [animation-delay:750ms]] %>
        <% @new_badges.each.with_index do |badge, index| %>
          <li class="flex items-center gap-3 rounded-box border border-base-300 bg-base-100 px-4 py-3 text-left motion-safe:animate-pop <%= delays[index] || delays.last %>">
            <%= render "badges/medallion", badge:, size: "size-12 text-2xl" %>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wide text-accent">New badge</p>
              <p class="font-semibold"><%= badge.title %></p>
              <p class="text-sm text-base-content/70"><%= badge.description %></p>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="w-full text-left">
      <%= render "challenge_rewards/pledge_reminder_banner", current_challenge_participant: @challenge_participant %>
    </div>

    <% if ask_for_push %>
      <% names = @challenge_participant.friends.map(&:name).first(3) %>
      <% message = names.any? ? "Hear when #{names.to_sentence} #{names.one? ? "checks" : "check"} in" : "Hear when friends join and check in" %>
      <div class="w-full" data-controller="push-notifications">
        <%= render "web_push_notifications/prompt", message:, dismissable: false %>
      </div>
    <% end %>

    <%= render "install_app/prompt", dismissable: false %>

    <%# The page behind the sheet doesn't reload, so its menu's progress card gets this check-in too %>
    <%= turbo_stream.replace dom_id(@challenge_participant, :share_card),
      partial: "challenge_stories/share_card_button",
      locals: {participant: @challenge_participant, id: dom_id(@challenge_participant, :share_card)} %>

    <div class="flex w-full flex-col gap-2">
      <%= render "challenge_stories/share_card_button", participant: @challenge_participant,
        css: "btn btn-outline btn-block rounded-full",
        action: ("close-sheet#stay:stop" if auto_close) %>
      <p class="text-xs text-base-content/60">Sharing to Instagram? The link is copied too: paste it into a Link sticker.</p>
      <%# Closes the sheet; opened as a full page, it goes to the challenge instead %>
      <%= link_to "Done", challenge_story_path(challenge_story),
        class: "btn btn-primary btn-block rounded-full",
        data: {turbo_frame: "_top", action: "close-sheet#close"} %>
    </div>
  <% end %>
<% end %>
