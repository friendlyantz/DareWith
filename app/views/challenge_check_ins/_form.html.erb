<%# locals: (challenge_story:, challenge_check_in:) %>
<%= turbo_frame_tag "new_message" do %>
  <div class="flex flex-col gap-4" data-controller="image-compressor">
    <p class="text-sm text-base-content/70">
      <%= challenge_story.title %> · <%= challenge_story.goal.progress_label.downcase %>
    </p>

    <%= form_with(model: [challenge_story, challenge_check_in], class: "flex flex-col gap-4", data: {sheet_stay_open: true}) do |form| %>
      <% if challenge_check_in.errors[:base].any? %>
        <div class="alert alert-error">
          <span><%= challenge_check_in.errors[:base].first %></span>
        </div>
      <% end %>

      <label class="relative flex flex-col items-center justify-center gap-1 h-44 overflow-hidden rounded-box border-2 border-dashed border-base-300 bg-base-100 cursor-pointer">
        <img data-image-compressor-target="preview" class="hidden absolute inset-0 size-full object-cover" alt="Selected photo">
        <%= icon(:camera, css: "size-8") %>
        <span class="font-semibold">Take or choose a photo</span>
        <span class="text-sm text-base-content/70">Optional, but friends love proof</span>
        <%= form.file_field :photo,
          class: "sr-only",
          accept: "image/*",
          data: {
            image_compressor_target: "input",
            action: "change->image-compressor#compress"
          } %>
      </label>

      <% if challenge_check_in.errors[:photo].any? %>
        <div class="alert alert-error">
          <span><%= challenge_check_in.errors[:photo].first %></span>
        </div>
      <% end %>

      <div class="alert hidden" data-image-compressor-target="status">
        <span></span>
      </div>

      <% if challenge_story.goal.measured? %>
        <fieldset class="fieldset">
          <label for="amount" class="fieldset-legend text-sm">How many <%= challenge_story.goal.unit_label %>?</label>
          <label class="<%= class_names("input input-lg w-full", "input-error": challenge_check_in.errors[:amount].any?) %>">
            <% goal = challenge_story.goal %>
            <%= form.number_field :amount, id: "amount", required: true,
              value: goal.format_number(challenge_check_in.amount || goal.suggested_amount),
              min: goal.whole_numbers? ? 1 : 0, step: goal.whole_numbers? ? 1 : "any",
              inputmode: goal.whole_numbers? ? "numeric" : "decimal", placeholder: "0" %>
            <span class="label"><%= challenge_story.goal.unit_label %></span>
          </label>
          <% challenge_check_in.errors.full_messages_for(:amount).each do |message| %>
            <p class="label text-error"><%= message %></p>
          <% end %>
        </fieldset>
      <% end %>

      <fieldset class="fieldset">
        <label for="message" class="fieldset-legend text-sm">What did you do?</label>
        <%= form.text_area :message,
          id: "message",
          rows: 3,
          required: true,
          placeholder: "e.g. 5 sets of squats, felt strong",
          class: ["textarea w-full text-base", {"textarea-error": challenge_check_in.errors[:message].any?}] %>
        <p class="label">Made a mistake? You can delete a check-in on the day you posted it.</p>
      </fieldset>

      <%= form.submit "Post check-in", class: "btn btn-primary btn-lg btn-block", id: "submit" %>
    <% end %>
  </div>
<% end %>
