<%# locals: (message:, dismissable:, ask: true) %>
<%# The push-notifications controller shows the one state that fits this browser, or removes the prompt %>
<div data-push-notifications-target="banner" class="hidden w-full">
  <div class="flex items-start gap-3 rounded-box border border-base-300 bg-base-200 p-3 text-left text-sm">
    <%= icon(:bell, css: "mt-0.5 size-5 shrink-0 text-primary") %>
    <% if ask %>
      <div data-push-notifications-target="ask" hidden class="flex flex-1 flex-wrap items-center gap-2">
        <span class="flex-1 min-w-40"><%= message %></span>
        <div class="flex gap-1">
          <button data-action="push-notifications#subscribe" class="btn btn-sm btn-primary">Turn on</button>
          <% if dismissable %>
            <button data-action="push-notifications#dismiss" class="btn btn-sm btn-ghost">Later</button>
          <% end %>
        </div>
      </div>
    <% end %>
    <%# Safari only offers push to the Home Screen app, and in-app browsers (Instagram...) can't add one %>
    <div data-push-notifications-target="install" hidden class="flex flex-1 flex-col gap-2">
      <span class="font-semibold"><%= message %></span>
      <span class="text-base-content/70">On iPhone, notifications only work in the DareWith app on your Home Screen:</span>
      <ol class="list-decimal pl-5 text-base-content/80">
        <% if likely_webview? %>
          <li>Open this page in Safari (tap ⋯, then "Open in Safari")</li>
        <% end %>
        <li>Tap ⋯ or ☰ next to the address bar, then <strong>Share</strong></li>
        <li>Tap <strong>Add to Home Screen</strong> (scroll down or tap "More" to find it), then <strong>Add</strong></li>
        <li>Open DareWith from your Home Screen and turn on notifications on Me</li>
      </ol>
      <% if likely_webview? && (browser_url = open_in_browser_url(request.get? ? request.original_url : today_url)) %>
        <%= link_to "Open in Safari", browser_url, class: "btn btn-sm btn-primary self-start" %>
      <% end %>
    </div>
    <div data-push-notifications-target="blocked" hidden class="flex flex-1 flex-col gap-1">
      <span class="font-semibold">Notifications are blocked for DareWith</span>
      <span class="text-base-content/70">Turn them back on in your phone's or browser's settings for this site, so friends' check-ins and nudges reach you.</span>
    </div>
    <% if dismissable %>
      <button data-push-notifications-target="close" data-action="push-notifications#dismiss" hidden class="btn btn-ghost btn-sm btn-square" aria-label="Later">✕</button>
    <% end %>
  </div>
</div>
