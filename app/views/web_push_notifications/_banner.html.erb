<% unless cookies[:push_notification_dismissed] %>
  <div class="flex justify-center px-5 pt-3">
    <div data-controller="push-notifications" data-push-notifications-endpoints-value="<%= current_user.web_push_notifications.pluck(:endpoint).to_json %>" data-action="push-notifications:subscribed@window->push-notifications#removeBanner" class="w-full max-w-md">
      <%= render "web_push_notifications/prompt", message: "Get notified when friends check in", dismissable: true %>
    </div>
  </div>
<% end %>
