<h1>Sign In to DareWith</h1>

<p>Hi <%= @user.username %>,</p>

<% if @code %>
  <p>Type this code on the sign-in page. It expires in 15 minutes.</p>
  <p style="font-size: 32px; font-weight: bold; letter-spacing: 6px; font-family: monospace;"><%= @code %></p>
  <p>Or tap the link below to sign in. It expires in 24 hours.</p>
<% else %>
  <p>Click the link below to sign in to your DareWith account. This link expires in 24 hours.</p>
<% end %>
<p>
  <%= link_to "Sign In to DareWith", @magic_link_url, style: "display: inline-block; padding: 10px 20px; background-color: #3b82f6; color: white; text-decoration: none; border-radius: 5px;" %>
</p>

<p style="color: #666;">
  Or copy and paste this link in your browser:<br>
  <code><%= @magic_link_url %></code>
</p>

<p style="color: #999; font-size: 12px;">
  If you didn't request this, you can safely ignore this email.
</p>
