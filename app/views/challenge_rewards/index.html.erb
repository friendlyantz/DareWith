<% content_for :title, "Rewards" %>
<div class="w-full max-w-md flex flex-col gap-5">
  <%# The Android app's toolbar has its own back button %>
  <% unless hotwire_native_app? %>
    <div class="-mx-2">
      <%= link_to challenge_story_path(@challenge_story), class: "btn btn-ghost px-2 gap-1" do %>
        <%= icon(:chevron_left) %> <%= @challenge_story.title %>
      <% end %>
    </div>
  <% end %>

  <div>
    <h1 class="font-display text-3xl font-bold tracking-tight">Rewards</h1>
    <% if @challenge_story.finished? %>
      <p class="text-sm text-base-content/70 mt-1">Time's up. Settle the pledges below.</p>
    <% end %>
  </div>

  <% if @current_challenge_participant %>
    <div class="flex flex-col gap-2">
      <% if @challenge_story.accepting_check_ins? && @current_challenge_participant.unpledged_participants.any? %>
        <%= link_to new_challenge_story_challenge_reward_path(@challenge_story), class: "btn btn-primary" do %>
          <%= icon(:plus, css: "size-4") %> Pledge a reward
        <% end %>
      <% end %>
      <% if @challenge_story.finished? && !@challenge_story.completed? %>
        <%= render "complete_button", challenge_story: @challenge_story %>
      <% end %>
    </div>
  <% end %>

  <% if @rewards_received.empty? && @rewards_given.empty? && @rewards_others.empty? %>
    <p class="rounded-box border border-base-300 bg-base-100 p-5 text-center text-base-content/70">No rewards have been pledged yet.</p>
  <% else %>
    <% [
      ["Pledged to you", @rewards_received],
      ["You pledged", @rewards_given],
      [@current_challenge_participant ? "Between others" : "All rewards", @rewards_others]
    ].each do |heading, rewards| %>
      <% next if rewards.empty? %>
      <section class="flex flex-col gap-2">
        <h2 class="text-sm font-semibold text-base-content/70"><%= heading %></h2>
        <% rewards.each do |reward| %>
          <%= render "reward_card", reward: reward, challenge_story: @challenge_story %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
