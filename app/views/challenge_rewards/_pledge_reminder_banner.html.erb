<% if current_challenge_participant&.active? && current_challenge_participant.missing_pledges? %>
  <% unpledged = current_challenge_participant.unpledged_participants %>
  <% if unpledged.any? %>
    <%= link_to new_challenge_story_challenge_reward_path(current_challenge_participant.challenge_story),
      data: {turbo: "false"},
      class: "flex items-center gap-3 rounded-box bg-warning/20 px-4 py-3" do %>
      <%= icon(:gift, css: "size-5 shrink-0") %>
      <span class="flex-1 text-sm">No reward pledged yet for <strong><%= unpledged.map(&:name).to_sentence %></strong></span>
      <span class="text-sm font-semibold shrink-0">Pledge</span>
    <% end %>
  <% end %>
<% end %>
