<%# locals: (reward:, challenge_story:) %>
<div class="flex flex-col gap-3 rounded-box border border-base-300 bg-base-100 p-4">
  <div class="flex items-start gap-3">
    <div class="flex size-10 shrink-0 items-center justify-center rounded-field bg-primary/10 text-accent">
      <%= icon(:gift) %>
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-semibold"><%= reward.description %></p>
      <p class="text-sm text-base-content/70 mt-0.5"><%= reward.giver.name %> → <%= reward.receiver.name %></p>
      <% if reward.fulfilled_at.present? %>
        <p class="text-sm text-base-content/70">Received <%= reward.fulfilled_at.strftime("%-d %b %Y") %></p>
      <% end %>
    </div>
    <span class="badge badge-sm <%= reward_status_class(reward.status) %>"><%= reward.status.capitalize %></span>
  </div>

  <% if reward.pending? %>
    <% receiver_user = reward.receiver.user %>
    <% giving = reward.giver.user == current_user %>
    <% receiving = receiver_user == current_user %>

    <% if challenge_story.settle_up_open? %>
      <% if giving && receiver_user.payment_details.present? %>
        <div class="flex items-center gap-3 rounded-field bg-base-200 px-3 py-2">
          <div class="flex-1 min-w-0 text-sm">
            <p class="font-semibold">Settle up with <%= reward.receiver.name %></p>
            <p class="truncate text-base-content/70"><%= receiver_user.payment_details %></p>
          </div>
          <% if receiver_user.payment_url %>
            <%= link_to "Pay", receiver_user.payment_url, target: "_blank", rel: "noopener noreferrer", class: "btn btn-sm btn-primary shrink-0" %>
          <% else %>
            <button type="button" class="btn btn-sm shrink-0" data-controller="clipboard" data-clipboard-text-value="<%= receiver_user.payment_details %>" data-action="clipboard#copy">Copy</button>
          <% end %>
        </div>
      <% elsif giving %>
        <p class="text-sm text-base-content/70"><%= reward.receiver.name %> hasn't added payment details. If this one involves money, sort it out together.</p>
      <% elsif receiving && current_user.payment_details.blank? %>
        <p class="text-sm text-base-content/70">
          If this reward involves money, <%= link_to "add how friends pay you", profile_path, class: "link link-accent" %>.
        </p>
      <% end %>
    <% end %>

    <% if (receiving && challenge_story.settle_up_open?) || (giving && challenge_story.finished?) %>
      <div class="flex justify-end gap-2">
        <% if giving && challenge_story.finished? %>
          <%= button_to "Cancel", cancel_challenge_story_challenge_reward_path(challenge_story, reward),
            method: :patch,
            class: "btn btn-sm btn-ghost text-error",
            data: {turbo_confirm: "Cancel this reward? #{reward.receiver.name} won't get it."} %>
        <% end %>
        <% if receiving && challenge_story.settle_up_open? %>
          <%= button_to "Mark as received", fulfill_challenge_story_challenge_reward_path(challenge_story, reward),
            method: :patch,
            class: "btn btn-sm btn-primary",
            data: {turbo_confirm: "Have you received this reward from #{reward.giver.name}?"} %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
