<%# locals: (challenge_story:) %>
<% penalties = challenge_story.penalty_mode ? " Penalties are tallied now." : "" %>
<div class="flex flex-col gap-1.5">
  <%= button_to "Complete for everyone", complete_challenge_story_path(challenge_story),
    method: :patch,
    class: "btn btn-block border-base-300 bg-base-100",
    data: {turbo_confirm: "Complete \"#{challenge_story.title}\" for all #{pluralize(challenge_story.active_participants.size, "participant")}? Check-ins close, and it moves to Past challenges for everyone.#{penalties} This can't be undone."} %>
  <p class="text-center text-xs text-base-content/60">
    Completes by itself on <%= challenge_story.completes_at.in_time_zone.strftime("%-d %b") %>, once everyone's grace day is over.
    <%= "Completing now tallies penalties straight away." if challenge_story.penalty_mode %>
  </p>
</div>
